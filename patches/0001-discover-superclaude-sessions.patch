From 6971d3987c26466ee2de79eb7f4662c24463a020 Mon Sep 17 00:00:00 2001
From: Marc <marc@schuetze.io>
Date: Wed, 6 May 2026 21:04:23 +0200
Subject: [PATCH] feat: discover externally-managed sc|<path> tmux sessions

Adds a third allowed mux-name pattern for sessions named `sc|<absolute-path>[-N]`
(produced by scharc/superclaude). Discovery and isValidMuxName accept them;
parsePaneList switches to a regex that locks onto the rightmost `|<digits>`
block so session names containing pipes parse correctly while preserving
forward-compat with hypothetical extra trailing fields.

Skips the `alias sc=tmux-chooser` line in install.sh to avoid clobbering
superclaude's existing `sc` binary.

Adds test/superclaude-compat.test.ts covering the parser change.
---
 install.sh                      |  8 +++---
 src/tmux-manager.ts             | 48 ++++++++++++++++++++++++++-------
 test/superclaude-compat.test.ts | 14 ++++++++++
 3 files changed, 55 insertions(+), 15 deletions(-)
 create mode 100644 test/superclaude-compat.test.ts

diff --git a/install.sh b/install.sh
index 4ced9a3..813bc5d 100755
--- a/install.sh
+++ b/install.sh
@@ -791,11 +791,9 @@ setup_sc_alias() {
         return 0
     fi
 
-    echo "" >> "$profile"
-    echo "# Codeman tmux session shortcut" >> "$profile"
-    echo "alias sc='tmux-chooser'" >> "$profile"
-
-    info "Added 'sc' alias for tmux-chooser"
+    # Skipped: `sc` collides with superclaude's session picker (~/.local/bin/sc).
+    # Use the explicit `tmux-chooser` command instead, or set your own alias.
+    info "Skipped 'sc' alias (use 'tmux-chooser' directly to avoid collisions)"
 }
 
 # ============================================================================
diff --git a/src/tmux-manager.ts b/src/tmux-manager.ts
index 5d5b2fd..689986a 100644
--- a/src/tmux-manager.ts
+++ b/src/tmux-manager.ts
@@ -95,6 +95,9 @@ const SAFE_MUX_NAME_PATTERN = /^codeman-[a-f0-9-]+$/;
 /** Legacy pattern for pre-rename sessions (claudeman- prefix) */
 const LEGACY_MUX_NAME_PATTERN = /^claudeman-[a-f0-9-]+$/;
 
+/** External superclaude sessions: `sc|<absolute-path>` with optional `-N` parallel suffix */
+const SUPERCLAUDE_MUX_NAME_PATTERN = /^sc\|\/[A-Za-z0-9._\-/~]+(?:-\d+)?$/;
+
 /** Regex to validate tmux pane targets (e.g., "%0", "%1", "0", "1") */
 const SAFE_PANE_TARGET_PATTERN = /^(%\d+|\d+)$/;
 
@@ -121,14 +124,22 @@ const PANE_LIST_FORMAT = `#{session_name}${PANE_LIST_SEP}#{pane_pid}`;
  * - Skips empty lines and lines without the separator.
  * - Skips entries with a non-numeric pid or empty name.
  */
+/**
+ * Match `<name>|<pid>` with optional trailing `|<extra>` fields.
+ * Greedy `.+` for name supports external session names containing '|'
+ * (e.g. superclaude's `sc|/abs/path`); regex backtracking locks onto the
+ * rightmost `|<digits>` block, leaving any future tmux-appended fields after.
+ */
+const PANE_LIST_LINE = /^(.+)\|(\d+)(?:\|.*)?$/;
+
 export function parsePaneList(output: string): Map<string, number> {
   const result = new Map<string, number>();
   for (const line of output.split('\n')) {
     if (!line) continue;
-    const sep = line.indexOf(PANE_LIST_SEP);
-    if (sep === -1) continue;
-    const name = line.slice(0, sep);
-    const pid = parseInt(line.slice(sep + 1), 10);
+    const m = PANE_LIST_LINE.exec(line);
+    if (!m) continue;
+    const name = m[1];
+    const pid = parseInt(m[2], 10);
     if (name && !Number.isNaN(pid)) {
       result.set(name, pid);
     }
@@ -144,7 +155,9 @@ const UNSAFE_PATH_CHARS = /[;&|$`(){}<>'"\n\r]/;
  * Prevents command injection via malformed session IDs.
  */
 function isValidMuxName(name: string): boolean {
-  return SAFE_MUX_NAME_PATTERN.test(name) || LEGACY_MUX_NAME_PATTERN.test(name);
+  return (
+    SAFE_MUX_NAME_PATTERN.test(name) || LEGACY_MUX_NAME_PATTERN.test(name) || SUPERCLAUDE_MUX_NAME_PATTERN.test(name)
+  );
 }
 
 /**
@@ -1015,20 +1028,35 @@ export class TmuxManager extends EventEmitter implements TerminalMultiplexer {
     }
 
     for (const [sessionName, pid] of activeSessions) {
-      if (!sessionName.startsWith('codeman-') && !sessionName.startsWith('claudeman-')) continue;
+      const isCodeman = sessionName.startsWith('codeman-') || sessionName.startsWith('claudeman-');
+      const isSuperclaude = SUPERCLAUDE_MUX_NAME_PATTERN.test(sessionName);
+      if (!isCodeman && !isSuperclaude) continue;
       if (knownMuxNames.has(sessionName)) continue;
 
-      const fragment = sessionName.replace(/^(?:codeman|claudeman)-/, '');
-      const sessionId = `restored-${fragment}`;
+      let sessionId: string;
+      let workingDir = process.cwd();
+      let displayName = `Restored: ${sessionName}`;
+      if (isSuperclaude) {
+        // sc|/abs/path[-N] — derive working dir from the slug and slugify for the id
+        const slug = sessionName.slice(3); // strip "sc|"
+        const path = slug.replace(/-\d+$/, '');
+        if (path.startsWith('/')) workingDir = path;
+        sessionId = `sc-${slug.replace(/[^A-Za-z0-9_-]+/g, '_')}`;
+        displayName = `sc: ${slug}`;
+      } else {
+        const fragment = sessionName.replace(/^(?:codeman|claudeman)-/, '');
+        sessionId = `restored-${fragment}`;
+      }
+
       const session: MuxSession = {
         sessionId,
         muxName: sessionName,
         pid,
         createdAt: Date.now(),
-        workingDir: process.cwd(),
+        workingDir,
         mode: 'claude',
         attached: false,
-        name: `Restored: ${sessionName}`,
+        name: displayName,
       };
       this.sessions.set(sessionId, session);
       discovered.push(sessionId);
diff --git a/test/superclaude-compat.test.ts b/test/superclaude-compat.test.ts
new file mode 100644
index 0000000..6ff5e4b
--- /dev/null
+++ b/test/superclaude-compat.test.ts
@@ -0,0 +1,14 @@
+import { describe, it, expect } from 'vitest';
+import { parsePaneList } from '../src/tmux-manager';
+
+describe('superclaude compat', () => {
+  it('parses sc|<path> session names with pipes', () => {
+    const r = parsePaneList('sc|/x/coding/02-private/superclaude|54321\ncodeman-aaaa|1111');
+    expect(r.get('sc|/x/coding/02-private/superclaude')).toBe(54321);
+    expect(r.get('codeman-aaaa')).toBe(1111);
+  });
+  it('handles sc|<path>-N parallel suffix', () => {
+    const r = parsePaneList('sc|/home/u/proj-2|9999');
+    expect(r.get('sc|/home/u/proj-2')).toBe(9999);
+  });
+});
-- 
