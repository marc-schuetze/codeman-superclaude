From 09fb671488b9a6f4ca4bb74d73427ff624cb77ad Mon Sep 17 00:00:00 2001
From: Marc <marc@schuetze.io>
Date: Thu, 21 May 2026 06:59:07 +0200
Subject: [PATCH 03/11] fix: wrap discovered tmux sessions in Session objects
 on reconcile
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

reconcileSessions() only populated the mux-layer session map — the API
route /api/mux-sessions/reconcile then returned, but the discovered ids
never got a corresponding server-side Session wrapper. The monitor panel
rendered them with status "UNKNOWN" because this.sessions.get(muxSession.sessionId)
returned undefined.

Promote the boot-time restoreMuxSessions() helper to a public method
reconcileMuxSessions() that does both halves (mux reconcile + Session
wrapping), expose it through InfraPort, and have the route call it.
Also broadcast SessionCreated for each newly-wrapped session so the
client's this.sessions map gets the new entries without a refresh.

Client: refresh on data.discovered > 0 too, not only data.dead.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 src/web/ports/infra-port.ts    | 1 +
 src/web/public/panels-ui.js    | 9 +++++++--
 src/web/routes/mux-routes.ts   | 2 +-
 src/web/server.ts              | 9 +++++++--
 test/routes/mux-routes.test.ts | 9 +++++----
 5 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/src/web/ports/infra-port.ts b/src/web/ports/infra-port.ts
index 322cdf3..b6dcf9f 100644
--- a/src/web/ports/infra-port.ts
+++ b/src/web/ports/infra-port.ts
@@ -35,4 +35,5 @@ export interface InfraPort {
   readonly pushStore: PushSubscriptionStore;
   startScheduledRun(prompt: string, workingDir: string, durationMinutes: number): Promise<ScheduledRun>;
   stopScheduledRun(id: string): Promise<void>;
+  reconcileMuxSessions(): Promise<{ alive: string[]; dead: string[]; discovered: string[] }>;
 }
diff --git a/src/web/public/panels-ui.js b/src/web/public/panels-ui.js
index 26918a9..73cc0a6 100644
--- a/src/web/public/panels-ui.js
+++ b/src/web/public/panels-ui.js
@@ -3867,8 +3867,13 @@ Object.assign(CodemanApp.prototype, {
       const res = await fetch('/api/mux-sessions/reconcile', { method: 'POST' });
       const data = await res.json();
 
-      if (data.data?.dead && data.data.dead.length > 0) {
-        this.showToast(`Found ${data.data.dead.length} dead mux session(s)`, 'warning');
+      const deadCount = data.data?.dead?.length ?? 0;
+      const discoveredCount = data.data?.discovered?.length ?? 0;
+      if (deadCount > 0 || discoveredCount > 0) {
+        const parts = [];
+        if (discoveredCount > 0) parts.push(`discovered ${discoveredCount}`);
+        if (deadCount > 0) parts.push(`${deadCount} dead`);
+        this.showToast(`Reconciled: ${parts.join(', ')}`, discoveredCount > 0 ? 'success' : 'warning');
         await this.loadMuxSessions();
       } else {
         this.showToast('All mux sessions are alive', 'success');
diff --git a/src/web/routes/mux-routes.ts b/src/web/routes/mux-routes.ts
index 14b9376..7eaeea2 100644
--- a/src/web/routes/mux-routes.ts
+++ b/src/web/routes/mux-routes.ts
@@ -23,7 +23,7 @@ export function registerMuxRoutes(app: FastifyInstance, ctx: InfraPort): void {
   });
 
   app.post('/api/mux-sessions/reconcile', async () => {
-    const result = await ctx.mux.reconcileSessions();
+    const result = await ctx.reconcileMuxSessions();
     return result;
   });
 
diff --git a/src/web/server.ts b/src/web/server.ts
index 428630c..101b5a7 100644
--- a/src/web/server.ts
+++ b/src/web/server.ts
@@ -604,6 +604,7 @@ export class WebServer extends EventEmitter {
       pushStore: this.pushStore,
       startScheduledRun: this.startScheduledRun.bind(this),
       stopScheduledRun: this.stopScheduledRun.bind(this),
+      reconcileMuxSessions: this.reconcileMuxSessions.bind(this),
       // AuthPort
       authSessions: this.authSessions,
       qrAuthFailures: this.qrAuthFailures,
@@ -1883,7 +1884,7 @@ export class WebServer extends EventEmitter {
     // This prevents race conditions where clients connect before state is ready
     // CRITICAL: Skip in test mode to prevent tests from picking up user sessions
     if (!this.testMode) {
-      await this.restoreMuxSessions();
+      await this.reconcileMuxSessions();
     }
 
     // Clean up stale sessions from state file that don't have active mux sessions
@@ -2089,7 +2090,7 @@ export class WebServer extends EventEmitter {
     return false;
   }
 
-  private async restoreMuxSessions(): Promise<void> {
+  async reconcileMuxSessions(): Promise<{ alive: string[]; dead: string[]; discovered: string[] }> {
     try {
       // Reconcile mux sessions to find which ones are still alive (also discovers unknown ones)
       const { alive, dead, discovered } = await this.mux.reconcileSessions();
@@ -2296,6 +2297,7 @@ export class WebServer extends EventEmitter {
             }
 
             this.persistSessionState(session);
+            this.broadcast(SseEvent.SessionCreated, this.getSessionStateWithRespawn(session));
           }
         }
 
@@ -2313,8 +2315,11 @@ export class WebServer extends EventEmitter {
       if (dead.length > 0) {
         console.log(`[Server] Cleaned up ${dead.length} dead mux session(s)`);
       }
+
+      return { alive, dead, discovered };
     } catch (err) {
       console.error('[Server] Failed to restore mux sessions:', err);
+      return { alive: [], dead: [], discovered: [] };
     }
   }
 
diff --git a/test/routes/mux-routes.test.ts b/test/routes/mux-routes.test.ts
index 999d645..421873d 100644
--- a/test/routes/mux-routes.test.ts
+++ b/test/routes/mux-routes.test.ts
@@ -93,8 +93,8 @@ describe('mux-routes', () => {
 
   describe('POST /api/mux-sessions/reconcile', () => {
     it('returns reconciliation result', async () => {
-      const reconcileResult = { orphaned: ['old-session'], missing: [], reconciled: 1 };
-      harness.ctx.mux.reconcileSessions = vi.fn(async () => reconcileResult);
+      const reconcileResult = { alive: ['s1'], dead: ['old-session'], discovered: ['s2'] };
+      harness.ctx.reconcileMuxSessions = vi.fn(async () => reconcileResult);
 
       const res = await harness.app.inject({
         method: 'POST',
@@ -102,8 +102,9 @@ describe('mux-routes', () => {
       });
       expect(res.statusCode).toBe(200);
       const body = JSON.parse(res.body);
-      expect(body.orphaned).toEqual(['old-session']);
-      expect(body.reconciled).toBe(1);
+      expect(body.dead).toEqual(['old-session']);
+      expect(body.discovered).toEqual(['s2']);
+      expect(body.alive).toEqual(['s1']);
     });
   });
 
