From deefe33b367f019889e91d7f91fa13701c678b5f Mon Sep 17 00:00:00 2001
From: Marc <marc@schuetze.io>
Date: Thu, 21 May 2026 06:59:16 +0200
Subject: [PATCH 04/10] fix: skip tmux mouse-mode toggle on discovered sessions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

startMouseModeSync overrides the user's global tmux mouse setting on every
tracked session (off by default, on if >1 pane). For externally-managed
sc|<path> sessions picked up by reconcileSessions(), this clobbers config
intended for the terminal-attached consumer — wheel events stop scrolling
the tmux buffer because mouse mode is forced off.

Mark sessions discovered via reconcile with a new MuxSession.discovered
flag and skip them in the mouse-mode sync loop. Sessions codeman creates
itself (including sc|<path>-named ones from the createSession path) are
untouched and keep the existing dynamic toggle.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 src/mux-interface.ts | 2 ++
 src/tmux-manager.ts  | 5 +++++
 2 files changed, 7 insertions(+)

diff --git a/src/mux-interface.ts b/src/mux-interface.ts
index 8c053c8..c8153f1 100644
--- a/src/mux-interface.ts
+++ b/src/mux-interface.ts
@@ -43,6 +43,8 @@ export interface MuxSession {
   respawnConfig?: PersistedRespawnConfig;
   /** Whether Ralph / Todo tracking is enabled */
   ralphEnabled?: boolean;
+  /** True if this session was found via reconcile, not created by codeman. Skip tmux option mutations (mouse mode, etc.) on these — they may be terminal-attached and have their own config. */
+  discovered?: boolean;
 }
 
 /**
diff --git a/src/tmux-manager.ts b/src/tmux-manager.ts
index a05df0e..25fd74c 100644
--- a/src/tmux-manager.ts
+++ b/src/tmux-manager.ts
@@ -1734,6 +1734,7 @@ export class TmuxManager extends EventEmitter implements TerminalMultiplexer {
         mode: 'claude',
         attached: false,
         name: displayName,
+        discovered: true,
       };
       this.sessions.set(sessionId, session);
       knownMuxNames.add(sessionName);
@@ -1940,6 +1941,10 @@ export class TmuxManager extends EventEmitter implements TerminalMultiplexer {
       if (IS_TEST_MODE) return;
 
       for (const session of this.sessions.values()) {
+        // Externally-managed sessions (discovered by reconcile) may have a terminal-attached
+        // consumer with its own mouse config — don't override.
+        if (session.discovered) continue;
+
         const panes = await this.listPanes(session.muxName);
         const count = panes.length;
         if (count === 0) continue;
-- 
