# Image tag — pin to a specific build for reproducibility, or use "latest".
IMAGE_TAG=latest

# Public hostname matched by desktop Traefik. Must fall under one of the
# zkm-catch wildcards on hetzner-edge: *.schuetze.io / *.scharc.de / *.x1it.de.
CODEMAN_HOST=code.scharc.de

# Optional: set a password to enable basic-auth fallback when the Authentik
# forward-auth chain is bypassed (e.g. local LAN access). Leave empty when
# fronted by protected@file — Authentik handles auth.
CODEMAN_PASSWORD=

# Host user — must match the UID that owns /tmp/tmux-<uid>/default and the
# project trees. `id -u` / `id -g` on the host.
HOST_UID=1000
HOST_GID=1000

# Host's home directory — mounted into the container at the same path so
# session working dirs and ~/.claude/projects/ paths resolve identically.
HOME_DIR=/home/scharc
